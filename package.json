{
  "name": "staticforge-engine",
  "version": "0.0.0",
  "private": true,
  "description": "StaticForge Engine — schema-driven static site generation monorepo.",
  "packageManager": "pnpm@11.6.0",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "echo \"No build configured yet\" && exit 0",
    "typecheck": "corepack pnpm -r typecheck",
    "test": "corepack pnpm -r test",
    "generate": "corepack pnpm --filter @staticforge/generator generate",
    "generate:ai": "cross-env USE_AI_GENERATION=true corepack pnpm generate",
    "import:csv": "corepack pnpm --filter @staticforge/core import:csv",
    "dev:web": "corepack pnpm --filter @staticforge/web dev",
    "build:web": "corepack pnpm --filter @staticforge/web build",
    "typecheck:web": "corepack pnpm --filter @staticforge/web typecheck",
    "typecheck:ai": "corepack pnpm --filter @staticforge/ai typecheck",
    "verify": "corepack pnpm generate && corepack pnpm -r typecheck && corepack pnpm -r test && corepack pnpm --filter @staticforge/web build",
    "staticforge": "corepack pnpm --filter @staticforge/cli start"
  },
  "devDependencies": {
    "cross-env": "^10.1.0"
  }
}
