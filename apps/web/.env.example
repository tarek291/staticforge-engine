# StaticForge — web application configuration.
#
# Copy to .env and fill in the real values. Placeholders are rejected at
# runtime rather than accepted and quietly failing later: a Supabase client
# pointed at "your-project" fails further from the mistake than this file does.

# The Supabase project the dashboard verifies user sessions against.
# Found under Project Settings → API in the Supabase dashboard.
SUPABASE_URL=https://your-project.supabase.co

# The *anon* key, not the service-role key.
#
# This value verifies someone else's token; it does not need to bypass row
# security and must not be able to. A service-role key here would give the
# web tier unrestricted database access through an environment variable that
# is copied between machines.
SUPABASE_ANON_KEY=your-anon-key
