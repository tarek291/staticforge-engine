# Postgres connection string. Copy this file to `.env` and fill in real values.
#
# Supabase exposes two URLs on the project's Database settings page:
#   - the pooled connection (port 6543), for the app at runtime
#   - the direct connection (port 5432), for migrations
# Prisma needs the direct URL to run `db push` / `migrate`, so start with that.
#
# `.env` is git-ignored. Never commit real credentials.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?schema=public"

# Shared secret for the /api/webhooks/sync endpoint.
#
# Generate a long random value: `openssl rand -hex 32`. The endpoint refuses
# every call while this is unset — a missing secret must never read as "no
# check required" on a route that writes tenant data and queues paid work.
#
# One secret authenticates the caller, not a tenant. Until per-project secrets
# exist, anyone holding it can sync any project the operator owns.
STATICFORGE_WEBHOOK_SECRET=""
