// StaticForge — multi-tenant data model.
//
// Tenancy: Workspace is the tenant root. Every other row reaches a Workspace
// through Project, so a tenant's data is a single subtree and can be scoped,
// exported, or deleted as one unit.
//
// This schema mirrors the file-based contracts the engine already validates
// (`@staticforge/schemas`), so the generator's semantics survive the move to a
// database — notably: a service slug is unique per project, a generated page
// slug is unique per project (the duplicate-slug guarantee), and templateId
// carries the service → project → "default" precedence.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A tenant: an agency or a customer account. The root of every ownership path.
model Workspace {
  id   String @id @default(cuid())
  name String

  /// URL-safe tenant handle. Globally unique — it identifies the tenant.
  slug String @unique

  /// The organization this workspace belongs to.
  ///
  /// The default exists so this column could be added to a populated table and
  /// names the single local organization, exactly as `Project.userId` names the
  /// single local operator. It is a migration affordance, not a fallback: a
  /// workspace whose organization is "whatever the default was" is a workspace
  /// nobody has decided the ownership of.
  organizationId String       @default("org-local")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  projects Project[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Not redundant with the primary key. It is what lets `Project` carry a
  /// composite foreign key to `(id, organizationId)`, which is what makes a
  /// project's organization impossible to disagree with its workspace's.
  @@unique([id, organizationId])
  @@index([organizationId])
}

/// One generated site. Owns the input entities and the generated output.
model Project {
  id          String  @id @default(cuid())
  name        String
  /// URL-safe handle, unique within the workspace rather than globally, so two
  /// tenants may both have a "main" project.
  slug        String
  description String?

  /// Content locale for generated pages. Mirrors `LocaleSchema` ("de" | "en").
  locale String @default("de")

  /// Absolute origin this project publishes at, e.g. "https://www.example.de".
  /// Without it a cloud run produces pages but no sitemap or robots.txt, since
  /// both need absolute URLs. Optional because a project may exist before its
  /// domain does.
  siteUrl String?

  /// Owning user. Every dashboard and API query filters on this, so a project
  /// is unreachable to anyone else even by guessing its id.
  ///
  /// The default exists so this column could be added to a populated table, and
  /// names the single local operator this phase assumes. It is a placeholder
  /// for real authentication, not a substitute: anything relying on it must
  /// keep working when the value comes from a session instead.
  userId String @default("local-operator")

  /// Project-level template default. The service-level value wins over it, and
  /// "default" applies when neither is set. Purely a rendering choice.
  templateId String @default("default")

  /// Project-level content-profile default, resolved by the same precedence.
  /// Independent of templateId: how a page looks and what it must contain are
  /// separate decisions, and a tenant may pair them however it likes.
  contentProfileId String @default("default")

  /// The organization this project belongs to, and what every authorisation
  /// check is decided against.
  ///
  /// Denormalised from the workspace, for the reason `GenerationJob.userId` is
  /// denormalised from the project: every read of this table is scoped, and a
  /// scope that needs a join is a scope somebody eventually writes without.
  ///
  /// Unlike most denormalisation, this one cannot drift. The foreign key below
  /// is composite — it points at `Workspace(id, organizationId)` — so Postgres
  /// itself refuses a project whose organization differs from its workspace's.
  /// The invariant is expressed in the schema rather than in a comment asking
  /// people to remember it.
  organizationId String       @default("org-local")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId, organizationId], references: [id, organizationId], onDelete: Cascade)

  business       Business?
  content        ContentTemplate?
  services       Service[]
  locations      Location[]
  generatedPages GeneratedPage[]
  jobs           GenerationJob[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, slug])
  @@index([workspaceId])
  @@index([userId])
  @@index([organizationId])
}

/// What a job was asked to do.
enum JobKind {
  /// Generate pages only.
  GENERATE
  /// Generate, validate, then build the site.
  BUILD
  /// Revise one existing page against operator feedback.
  REFRESH
}

/// Where a job is in its life.
enum JobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

/// One background run of the engine.
///
/// Generating five hundred pages takes longer than an HTTP request may, so the
/// dashboard records the intent, answers immediately, and lets the browser poll
/// this row. The job is the unit of truth about a run — not the response.
model GenerationJob {
  id String @id @default(cuid())

  kind   JobKind
  status JobStatus @default(PENDING)

  /// Combined stdout and stderr, flushed periodically while the job runs so a
  /// poller sees progress rather than a blank screen followed by a verdict.
  logs     String @default("")
  exitCode Int?

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// Denormalised from the project so a job can be scoped without a join —
  /// which matters because every read of this table is scoped.
  userId String

  /// For a REFRESH job: which page, and what the operator asked to change.
  targetSlug String?
  feedback   String?

  /// For a scoped GENERATE job: the exact pages this run may re-author.
  ///
  /// Empty means unscoped, which is a full run — the behaviour every job had
  /// before this column existed, and the behaviour a job degrades to if the
  /// scope is ever lost. That direction matters: an unscoped run costs more
  /// than it needed to, while a scope arriving from nowhere would silently
  /// stop authoring pages nobody excluded.
  ///
  /// The scope gates the AI authoring pass and nothing else. The run still
  /// builds, links, and persists the whole project, because the link graph is
  /// computed across every page and the sitemap describes all of them — a run
  /// that wrote only its scope would publish a site missing everything else.
  /// Authoring is the only step with a marginal cost, so it is the only step
  /// worth narrowing.
  targetSlugs String[] @default([])

  /// How far along the run is, as a whole percentage of 0-100.
  ///
  /// Derived from the counts below rather than reported independently, so a
  /// progress bar and a page count can never disagree. Stored rather than
  /// computed on read because the dashboard polls this row and the counts it
  /// would divide are on the same row anyway - one number the UI can bind to.
  progress Int @default(0)

  /// Pages this run expects to produce. Null until the run has loaded its input
  /// and knows: a job that has not started yet cannot honestly report a total,
  /// and zero would read as "nothing to do".
  totalCount Int?

  /// Pages finished so far, including ones skipped because a previous attempt
  /// had already written them.
  completedCount Int @default(0)

  /// Pages this run could not produce. Kept apart from `completedCount` so a
  /// run that finished with failures is distinguishable from a clean one
  /// without reading the log.
  failedCount Int @default(0)

  /// Which server instance claimed this job, and until when that claim holds.
  ///
  /// A job row outlives the process updating it, so "RUNNING" alone cannot mean
  /// "alive" the moment more than one instance exists — a booting instance that
  /// failed every RUNNING row would kill work another instance is doing right
  /// now. The lease is the liveness signal instead: the owner renews it while it
  /// works, and only an *expired* lease (or this instance's own leftovers, which
  /// cannot have survived its restart) may be reclaimed.
  lockedBy       String?
  leaseExpiresAt DateTime?

  createdAt   DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?

  @@index([projectId, createdAt])
  @@index([userId, createdAt])
  /// Orphan recovery scans by status and lease, on every instance boot. Without
  /// this it is a full scan of every tenant's job history.
  @@index([status, leaseExpiresAt])
}

/// A content profile a tenant may hold, stored rather than compiled in.
///
/// The quality policy — how long a title should be, how many sections carry an
/// argument, which section kinds belong — was a constant in `@staticforge/schemas`.
/// That made every new policy a code change and a deploy, which is the wrong
/// shape for something a tenant is meant to choose and, eventually, buy.
///
/// The *definition* is data. What it is checked against is not: the JSON is
/// parsed with `ContentProfileSchema` before anything uses it, so a row that
/// does not describe a real profile is refused rather than half-applied.
model ContentProfile {
  id String @id @default(cuid())

  /// The identifier a page stores in `contentProfileId`, e.g. "strictSeo".
  ///
  /// Distinct from `id` on purpose. Pages reference a profile by a readable
  /// key, and two tenants must both be able to have a "premium" profile — which
  /// a shared primary key would forbid.
  key String

  /// Human label, for a picker. Never used to resolve anything.
  name String

  /// The `ContentProfileSchema` payload. Stored as JSON because it is read
  /// whole and never queried field by field.
  definition Json

  /// Available to every tenant. The shipped profiles are global; a tenant's own
  /// are not.
  isGlobal Boolean @default(false)

  /// Owning user, or the shared sentinel `__global__` for a shipped row.
  ///
  /// Not nullable, and that is deliberate rather than incidental. Postgres
  /// treats NULL as distinct from every other NULL, so a UNIQUE(key, userId)
  /// with a nullable owner would happily accept two rows both claiming to be
  /// the global "default" — the exact duplicate the constraint exists to
  /// prevent, silently permitted in the one case that matters most. A sentinel
  /// makes the constraint mean what it reads as.
  userId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One meaning per key per owner. Globals share a namespace of their own,
  /// which is why the owner is part of the constraint rather than the key alone.
  @@unique([key, userId])
  @@index([userId])
  @@index([isGlobal])
}

/// A template a tenant may hold.
///
/// ## What is data here, and what deliberately is not
///
/// A template's *definition* is data: which view renders it and how that view
/// is configured. The view itself stays code, and that is not a limitation to
/// be lifted later — it is the security boundary. A "template" that carried
/// renderable code from a database into a React tree would be remote code
/// execution wearing a marketplace's clothes, and no amount of validating the
/// JSON around it would change that.
///
/// So a row names a registered view and configures it. Selling a template means
/// selling a configuration, and adding a genuinely new *look* stays a code
/// change — which is the honest trade.
model Template {
  id String @id @default(cuid())

  /// The identifier a page stores in `templateId`, e.g. "luxuryLanding".
  key String

  /// Human label, for a picker.
  name String

  /// The `TemplateDefinitionSchema` payload: the view to render through, and
  /// its configuration.
  definition Json

  isGlobal Boolean @default(false)

  /// Owning user, or `__global__`. Non-nullable for the reason given on
  /// `ContentProfile.userId`: a nullable owner defeats the unique constraint.
  userId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([key, userId])
  @@index([userId])
  @@index([isGlobal])
}

/// Business verticals. Values match `NicheSchema` exactly, so the mapping into
/// the engine is a pass-through rather than a translation table.
enum Niche {
  cleaning
  moving
  handyman
  coaching
  security
}

/// The trading identity behind a project — the "who" on every generated page.
///
/// One per project, kept separate from Workspace: a Workspace is the tenant
/// (an agency may own many sites), while a Business is the company a single
/// site speaks for.
model Business {
  /// A UUID rather than the cuid used elsewhere, because `BusinessSchema.id`
  /// is validated with `.uuid()`.
  id String @id @default(uuid()) @db.Uuid

  name String
  slug String
  /// 50–500 characters, per `BusinessSchema`.
  description String
  niche       Niche
  foundedYear Int?

  contactEmail String
  contactPhone String

  /// Address, flattened. `AddressSchema` is a value object with no identity of
  /// its own, so a separate table would buy nothing.
  addressStreet     String
  addressCity       String
  addressState      String
  addressPostalCode String
  addressCountry    String @default("DE")

  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// The language-agnostic content template a project renders through.
/// Mirrors `StaticContentTemplate`.
model ContentTemplate {
  id String @id @default(cuid())

  /// `{{service}}`, `{{city}}` and `{{business}}` placeholders are resolved by
  /// the generator, which rejects any other placeholder name.
  heroTitleTemplate    String
  heroSubtitleTemplate String

  ctaPrimary String
  /// Label for the optional secondary CTA. Empty string means "no secondary".
  ctaSecondary String @default("")

  /// `[{ q, a }]`, at least three entries. Stored as JSON because the template
  /// is read whole and never queried per entry.
  faqs Json

  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A service offered within a project. Mirrors `ServiceSchema`.
model Service {
  id          String @id @default(cuid())
  name        String
  /// Curated, not derived: slug derivation strips diacritics rather than
  /// transliterating them, and a page's URL depends on this value.
  slug        String
  description String

  /// Stored as a list rather than a join table: benefits are opaque strings
  /// that are never queried or shared across services.
  benefits String[]

  priceFrom     Decimal? @db.Decimal(10, 2)
  priceTo       Decimal? @db.Decimal(10, 2)
  priceCurrency String?

  /// Optional per-service template override. Highest precedence.
  templateId String?

  /// Optional per-service content-profile override. Highest precedence.
  contentProfileId String?

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  generatedPages GeneratedPage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Two services sharing a slug in one project would produce colliding page
  /// slugs — the collision the generator already refuses to write.
  @@unique([projectId, slug])
  @@index([projectId])
}

/// A place a project serves. Mirrors `LocationSchema`.
model Location {
  id   String @id @default(cuid())
  /// Display name of the place. Kept alongside `city` because a location may be
  /// labelled differently from its city ("Ruhrgebiet" covering "Essen").
  name String
  slug String

  city       String
  state      String
  country    String  @default("DE")
  postalCode String?

  latitude  Float?
  longitude Float?

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  generatedPages GeneratedPage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, slug])
  @@index([projectId])
}

/// How a page's content was produced.
enum PageSource {
  /// Assembled from the content template — deterministic, no model involved.
  TEMPLATE
  /// Authored by the AI pass.
  AI
  /// Edited by a human after generation.
  MANUAL
}

/// A fully resolved page, ready to render. Mirrors `GeneratedPageSchema`.
model GeneratedPage {
  id String @id @default(cuid())

  /// Route slug, unique per project — the database-level counterpart of the
  /// generator's duplicate-slug guard.
  slug            String
  locale          String
  title           String
  metaDescription String
  h1              String

  /// The `PageContentSchema` payload (hero, sections, faq, cta). Stored as JSON
  /// because it is rendered whole and never queried field by field.
  content Json

  /// JSON-LD structured data, shape depending on the `@type` used.
  schemaOrg Json

  templateId       String     @default("default")
  /// The profile this page was judged against, recorded alongside the template
  /// it renders through so a dashboard can show both independently.
  contentProfileId String     @default("default")
  source           PageSource @default(TEMPLATE)

  /// Provenance of authored content: prompt version, model, content profile and
  /// the source fingerprint. Null on deterministic template pages — there is no
  /// model to attribute. Mirrors `PageGenerationSchema`.
  generation Json?

  /// Contextual links to sibling pages, as `[{ slug, anchor, relation }]`.
  /// Stored as JSON because the graph is written and read whole; querying it
  /// per edge would be a different feature with a different shape.
  links Json @default("[]")

  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  serviceId  String
  service    Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, slug])
  /// One page per service-in-city combination, matching the generator's
  /// cartesian product.
  @@unique([projectId, serviceId, locationId])
  @@index([projectId])
  @@index([serviceId])
  @@index([locationId])
}

// ---------------------------------------------------------------------------
// Enterprise layer: organizations, membership, and the audit trail
// ---------------------------------------------------------------------------

/// What a member may do inside an organization.
///
/// Ordered, and the order is the whole authorisation model: OWNER > EDITOR >
/// VIEWER. A rank comparison rather than a permission matrix, because a matrix
/// invites per-action exceptions and the first exception is the one nobody
/// reviews. Where an action genuinely needs more than "can write" — deleting a
/// project, changing who is a member — it is expressed as requiring OWNER, not
/// as a special case bolted onto EDITOR.
enum OrgRole {
  /// Full control, including deleting projects and managing membership.
  OWNER
  /// May change content and run the engine. May not delete a project or add a
  /// member — both are actions whose damage outlives the person doing them.
  EDITOR
  /// Read only. Explicitly cannot sync, generate, or edit.
  VIEWER
}

/// The tenant root, and the thing that is billed.
///
/// `Workspace` held this position before this phase and still groups projects,
/// but it had no concept of a person: every query scoped on a `userId` column
/// that defaulted to a single local operator. An organization is where people
/// and their roles live, so it becomes the root that authorisation is decided
/// against.
///
/// The two are deliberately *not* merged here. Renaming a populated model is a
/// destructive migration and deserves to be its own change, reviewed on its own
/// terms, rather than a side effect of adding roles.
model Organization {
  id   String @id @default(cuid())
  name String

  /// URL-safe handle. Globally unique — it identifies the tenant.
  slug String @unique

  members    OrganizationMember[]
  workspaces Workspace[]
  projects   Project[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// One person's role in one organization.
///
/// The row *is* the membership: no row means no access, which is the same
/// answer as an organization that does not exist. That equivalence is
/// deliberate — an authorisation check that distinguished "you are not a
/// member" from "no such organization" would be a way to enumerate tenants.
model OrganizationMember {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// The user this membership is for. A plain column rather than a relation
  /// because there is no user table yet — authentication is still unbuilt, and
  /// inventing half of it here would produce a model the real one has to
  /// undo. What matters now is that the *role* is stored and enforced.
  userId String

  role OrgRole @default(VIEWER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One role per person per organization. Two rows would make the answer to
  /// "what may this user do" depend on which one was read first, and the
  /// generous reading is the one that would win in practice.
  @@unique([organizationId, userId])
  @@index([userId])
}

/// An append-only record of what happened, and who caused it.
///
/// Not a log file. A log is trimmed, rotated and read by whoever has shell
/// access; this is a table a customer can be shown, scoped to their own
/// organization, when they ask who changed a page or what a sync did.
///
/// ## Why nothing cascades into it
///
/// `resourceId` is a plain string and not a relation, so deleting a project
/// does not delete the record of the project being deleted. A trail that
/// disappears with the thing it describes cannot answer the question it exists
/// for, and "who removed this" is the question an audit log is bought for.
model AuditLog {
  id String @id @default(cuid())

  /// What happened, as a stable dotted name: `project.synced`, `job.completed`.
  /// Stable because these are queried and alerted on; renaming one silently
  /// breaks every saved filter built against it.
  action String

  /// The thing it happened to — a project id, a job id, a page slug. Untyped
  /// on purpose: the trail must be able to record an action against something
  /// that has since been deleted.
  resourceId String

  /// Who caused it. Denormalised for the same reason `GenerationJob.userId` is:
  /// every read of this table is scoped, and a scope that needs a join is a
  /// scope somebody eventually writes without.
  userId String

  /// The organization the event belongs to, for scoping and export.
  ///
  /// Nullable because a local run legitimately has no organization, and a
  /// record with no home is still better than no record. Rows without one are
  /// invisible to a tenant-scoped read, which is the correct outcome: they did
  /// not happen to a tenant.
  organizationId String?

  /// Everything else, as a flat JSON object. Deliberately unconstrained: an
  /// audit trail whose shape is pinned by a schema stops recording the fields
  /// that were added after it, which are exactly the ones an investigation
  /// needs.
  details Json @default("{}")

  createdAt DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([userId, createdAt])
  @@index([resourceId, createdAt])
  @@index([action, createdAt])
}

// ---------------------------------------------------------------------------
// Distributed rate limiting
// ---------------------------------------------------------------------------

/// One token bucket, shared by every process that consumes from it.
///
/// ## Why this is a table and not a counter in memory
///
/// Rate limiting in process memory works exactly until there is a second
/// process, and Phase 14 made the worker a process you are meant to run more
/// than one of. Two workers each politely holding themselves to the provider's
/// limit will together exceed it, every time, and the failure arrives as 429s
/// in the middle of a paid run rather than as anything anyone designed.
///
/// The limit belongs to the *tenant and the provider*, not to a process, so the
/// state has to live where every process can see it. Postgres already holds the
/// queue those processes coordinate through; adding Redis here would be a
/// second thing to run and secure for a row that is updated a few times a
/// minute.
///
/// ## Why the row can be thrown away
///
/// Nothing else references it and nothing cascades into it. A deleted row means
/// the next caller starts from a full bucket, which is the same state a new
/// tenant starts in — so this table can be truncated to recover from a bad
/// configuration without touching anything that matters.
model RateLimitState {
  /// The bucket's identity, chosen by the caller — a project id, a provider
  /// name, or both. Not generated: the whole point is that two processes
  /// computing the same key reach the same row.
  id String @id

  /// Whole tokens currently available.
  ///
  /// Integer, so the fractional remainder of a refill has to be carried
  /// somewhere — see `lastRefillAt`, which is advanced by exactly the time the
  /// granted tokens represent rather than to "now". Rounding it away instead
  /// would quietly under-deliver on every call and starve a caller that polls
  /// faster than one token's worth of time.
  availableTokens Int

  /// The instant the bucket was last credited up to.
  ///
  /// Deliberately not "the last time this row was touched". Tokens accrue from
  /// this point, so a denied request must leave it alone — the time it waited
  /// is time the bucket was still filling.
  lastRefillAt DateTime
}
