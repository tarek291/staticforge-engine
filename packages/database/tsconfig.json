{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    // rootDir is the package root, not ./src, so `prisma/seed.ts` is inside the
    // program and actually gets typechecked. The package never emits (main
    // points at src/index.ts and typecheck runs --noEmit), so this only widens
    // what tsc reads.
    "rootDir": ".",
    "outDir": "./dist"
  },
  // `prisma.config.ts` is listed explicitly. It sits at the package root rather
  // than under `src`, so the globs above miss it — and a config the compiler
  // never sees is one whose typo surfaces as a Prisma CLI failure in a deploy
  // log instead of as a red squiggle.
  "include": ["src/**/*", "prisma/**/*.ts", "prisma.config.ts"],
  "exclude": ["dist", "node_modules"]
}
